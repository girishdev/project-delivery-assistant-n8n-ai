        "messages": {
          "values": [
            {
              "content": "=\n{{ `You are an AI Project Delivery Assistant for software projects.\n\nAnalyze the project plan and meeting transcript.\n\nGenerate these four sections:\n\n1. MEETING SUMMARY (MoM)\n- Meeting date\n- Key discussions\n- Decisions made\n\n2. ACTION ITEMS\n- Task\n- Owner\n- Due date\n- Status\n\n3. RISKS AND BLOCKERS\n- Risk description\n- Business/project impact\n- Suggested mitigation\n\n4. PROJECT STATUS REPORT\n- Completed tasks\n- Pending tasks\n- Milestone progress\n- Overall status: On Track / At Risk / Delayed\n\nCompare the meeting updates against the project plan.\n\nRules:\n- Do not invent missing information.\n- Highlight any mismatch between the plan and meeting.\n- Flag uncertain dates or owners.\n- Mention items requiring Project Manager approval.\n- Use clear headings and concise tables.\n\nPROJECT PLAN:\n${$json.project_plan_text}\n\nMEETING TRANSCRIPT:\n${$json.meeting_text}` }}\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -32,
        -512
      ],
